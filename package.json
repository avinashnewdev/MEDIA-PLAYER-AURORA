{
  "name": "media-player-aurora",
  "version": "1.0.0",
  "description": "Aurora Music & Video Player",
  "author": "Aurora Media Player contributors",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:android": "cap sync android && cd android && ./gradlew assembleDebug",
    "build:ios": "cap sync ios",
    "check:js": "node --check electron-main.js && node --check sw.js && node scripts/check-inline-scripts.cjs"
  },
  "build": {
    "appId": "com.avinash.auroraplayer",
    "productName": "Aurora Media Player",
    "files": [
      "electron-main.js",
      "index.html",
      "manifest.webmanifest",
      "sw.js",
      "icon-192.png",
      "icon-512.png"
    ],
    "win": {
      "icon": "icon-512.png",
      "target": [
        "portable"
      ]
    }
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/ios": "^6.1.0",
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3"
  }
}
