{
  "name": "media-player-aurora",
  "version": "1.0.0",
  "description": "Aurora Music & Video Player",
  "author": "Avinash Jadhav",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.avinash.auroraplayer",
    "productName": "Aurora Media Player",
    "files": [
      "electron-main.js",
      "index_2.html",
      "manifest.webmanifest",
      "sw.js",
      "icon-192.png",
      "icon-512.png"
    ],
    "win": {
      "icon": "icon-512.png",
      "target": ["portable"]
    }
  },
  "devDependencies": {
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3"
  }
}
